# Client build-time variables. Everything prefixed with VITE_ is PUBLIC and
# ends up in the browser bundle - never put secrets here.

# Base URL of the API. Leave empty when the API is served from the same origin
# (Vite dev proxy or SERVE_CLIENT=true). Example: https://api.example.com
VITE_API_BASE_URL=

# MapTiler raster tiles. This value is public in the browser bundle, so use a
# MapTiler key restricted to your site URLs. Do not put a server secret here.
# Rebuild after changing it. Example:
# VITE_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_MAPTILER_KEY
VITE_TILE_URL=

# Dev only: where the Vite dev server proxies /api requests
VITE_DEV_API_PROXY=http://localhost:5000
