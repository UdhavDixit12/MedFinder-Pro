# ---------------------------------------------------------------
# MedFinder Pro - server environment (copy to server/.env)
# All values below are placeholders. Never commit real secrets.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Comma-separated list of allowed browser origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (local or MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/medfinder_pro

# JWT signing secret - use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Auth cookie settings. Use COOKIE_SAMESITE=none (with HTTPS) only when the
# frontend and backend are deployed on different sites.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Identify your app to OpenStreetMap services (required by Nominatim usage policy)
OSM_USER_AGENT=MedFinderPro/1.0 (contact: you@example.com)
OSM_CONTACT_EMAIL=you@example.com

# Geocoding + Overpass endpoints (server-side configuration only; users cannot override)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter,https://lz4.overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_TIMEOUT_MS=30000
# Shorter per-endpoint timeout used before falling back to the next endpoint
OVERPASS_FAILOVER_TIMEOUT_MS=12000

# Optional: OpenAI-compatible chat completions API for the symptom checker.
# Leave AI_API_KEY empty to use the built-in rule-based guidance.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Optional: serve the built client (client/dist) from Express in production
SERVE_CLIENT=false
